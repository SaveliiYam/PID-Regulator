{
  "name": "PIDReg",
  "version": "1.2.0",
  "description": "PID regulator with relay autotune, SOLID interfaces and anti-windup for Arduino / PlatformIO",
  "keywords": "pid, control, regulator, feedback, autotune, esp32, arduino",
  "authors": [
    {
      "name": "Savelii Yam",
      "url": "https://github.com/SaveliiYam"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SaveliiYam/PID-Regulator.git"
  },
  "homepage": "https://github.com/SaveliiYam/PID-Regulator",
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "headers": [
    "PidController.h",
    "IPidController.h",
    "PidAutotuner.h",
    "IPidAutotuner.h",
    "IPidTuningRule.h",
    "PidTunings.h",
    "PidAutotuneTypes.h",
    "OutputClamp.h",
    "ZieglerNicholsRule.h"
  ],  "examples": [
    {
      "name": "Basic",
      "base": "examples/Basic",
      "files": ["Basic.ino"]
    },
    {
      "name": "Autotune",
      "base": "examples/Autotune",
      "files": ["Autotune.ino"]
    }
  ],
  "export": {
    "include": [
      "src/*",
      "examples/*",
      "library.json",
      "library.properties",
      "keywords.txt",
      "LICENSE",
      "README.md",
      "README.ru.md"
    ],
    "exclude": [
      ".pio",
      ".vscode",
      ".git",
      "platformio.ini"
    ]
  }
}
